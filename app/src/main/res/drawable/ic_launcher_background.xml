    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="@color/night_sky" android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M28,54a26,26 0,1 1,52 0a26,26 0,1 1,-52 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="28"
                android:endX="54" android:endY="80">
                <item android:offset="0" android:color="@color/sunset" />
                <item android:offset="1" android:color="@color/rust" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- sun stripes, thickening towards the horizon -->
    <path android:fillColor="@color/night_sky"
        android:pathData="M20,58h68v1.5h-68z M20,63.5h68v2.5h-68z M20,70h68v3.5h-68z M20,77h68v5h-68z" />
